# ==============================================================================
# MYMART - Git Ignore Rules
# ==============================================================================

# Operating System Files
# ----------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE & Code Editor Files
# -----------------------
# Visual Studio Code
.vscode/
**/.vscode/
*.code-workspace

# JetBrains / IntelliJ IDEA / WebStorm / PyCharm
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Eclipse / NetBeans
.project
.classpath
.settings/
nbproject/
build.xml

# Node.js & Package Managers (if initialized in future)
# ----------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json.bak

# Build Artifacts & Output
# ------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/

# Deployment & Cloud Hosting Caches
# ---------------------------------
.vercel/
.netlify/
.output/

# Environment Variables & Secrets (CRITICAL: Never commit secrets)
# ----------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
secrets/

# Temporary, Scratch & Log Files
# ------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
