{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/MYMART/index.html"
    },
    {
      "source": "/(products|product-details|cart|checkout|login|register|profile|orders)",
      "destination": "/MYMART/$1.html"
    },
    {
      "source": "/(.*)",
      "destination": "/MYMART/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
